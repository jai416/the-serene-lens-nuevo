# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Resend (transactional emails)
RESEND_API_KEY=re_your_key_here

# Cron Job Auth
CRON_SECRET=generate-with-crypto-randombytes
CRONJOB_API_KEY=your-cronjob-api-key

# QvaPay Payments (v2 API)
QVAPAY_UUID=your-app-id-here
QVAPAY_SECRET=your-app-secret-here
QVAPAY_API_URL=https://api.qvapay.com
QVAPAY_TAX_RATE=0

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin (optional)
ROOT_ADMIN_EMAIL=admin@example.com

# App URL (for SEO sitemap/robots)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CUP exchange rate fallback for pricing
NEXT_PUBLIC_CUP_FALLBACK=500

# WhatsApp contact number
NEXT_PUBLIC_WHATSAPP_NUMBER=5350000000

# Exchange Rate API (optional, for currency conversion)
EXCHANGERATE_API_KEY=

# Analytics & Error Tracking
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Affiliate Search API (optional)
RAINFOREST_API_KEY=

# Photo Steps Config (optional, for A/B testing)
NEXT_PUBLIC_PHOTO_STEPS=4

# Seed admin password (used by prisma/seed.ts)
SEED_ADMIN_PASSWORD=admin123
