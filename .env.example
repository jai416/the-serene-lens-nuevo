# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_PREMIUM_PRICE_ID=price_your_premium_id
STRIPE_PRO_PRICE_ID=price_your_pro_id
STRIPE_BASIC_PACK_PRICE_ID=price_basic_pack
STRIPE_POPULAR_PACK_PRICE_ID=price_popular_pack
STRIPE_ADVANCED_PACK_PRICE_ID=price_advanced_pack

# QvaPay Payments
QVAPAY_UUID=your-uuid-here
QVAPAY_SECRET=your-secret-here
QVAPAY_URL=https://qvapay.com
QVAPAY_API_URL=https://qvapay.com/api/v1
QVAPAY_TAX_RATE=0

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin (optional)
ROOT_ADMIN_EMAIL=admin@example.com

# App URL (for SEO sitemap/robots)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CUP exchange rate fallback for pricing
NEXT_PUBLIC_CUP_FALLBACK=500

# WhatsApp contact number
NEXT_PUBLIC_WHATSAPP_NUMBER=5350000000

# Exchange Rate API (optional, for currency conversion)
EXCHANGERATE_API_KEY=
