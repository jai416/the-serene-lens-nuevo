# ─── Base de Datos ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your-nextauth-secret-here"

# ─── Admin ─────────────────────────────────────────────────────
ROOT_ADMIN_EMAIL="admin@ejemplo.com"

# ─── Groq API (Análisis de Piel) ───────────────────────────────
GROQ_API_KEY=

# ─── Gemini API Keys ──────────────────────────────────────────
# Eliminadas: migración completa a Groq.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# ─── QvaPay (Pagos) ────────────────────────────────────────────
QVAPAY_UUID=your-app-id-here
QVAPAY_SECRET=your-app-secret-here
QVAPAY_API_URL=https://api.qvapay.com
QVAPAY_TAX_RATE=0

# ─── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth ──────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Gmail SMTP ────────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Precios ───────────────────────────────────────────────────
NEXT_PUBLIC_CUP_FALLBACK=500

# ─── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── WhatsApp ──────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Exchange Rate API ─────────────────────────────────────────
EXCHANGERATE_API_KEY=

# ─── Email Providers ───────────────────────────────────────────
MAILJET_API_KEY=
MAILJET_API_SECRET=
SENDGRID_API_KEY=
BREVO_API_KEY=
RESEND_API_KEY=
RESEND_DOMAIN_VERIFIED=false

# ─── Cron Jobs ─────────────────────────────────────────────────
CRON_SECRET=generate-with-crypto-randombytes

# ─── PostHog (Analytics) ───────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Supabase Storage ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Sentry ────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ─── Seed ──────────────────────────────────────────────────────
SEED_ADMIN_PASSWORD=admin123

# ─── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_TOKEN=123456789:ABCdefGHIjklmNOPqrstUVwxyz
TELEGRAM_GROUP_ID=-123456789
TELEGRAM_ADMIN_TOKEN=admin_token_secreto_12345
TELEGRAM_VALIDATOR_TOKEN=validator_token_secreto_67890
TELEGRAM_WEBHOOK_SECRET=random-secret-for-webhook-verification

# ─── Umbrales del Bot ──────────────────────────────────────────
PAYPAL_TIMEOUT_MINUTES=5
TRANSFER_PENDING_TIMEOUT_HOURS=2
TRANSFER_VALIDATED_TIMEOUT_MINUTES=30

# ─── Transfermóvil ─────────────────────────────────────────────
TRANSFER_ACCOUNT=9238000000000000
TRANSFER_HOLDER=Nombre del Titular

# ─── PayPal ────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ─── URLs del Sitio ────────────────────────────────────────────
SITE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
