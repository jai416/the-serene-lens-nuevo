# ─── Base de Datos ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your-nextauth-secret-here"

# ─── Admin ─────────────────────────────────────────────────────
ROOT_ADMIN_EMAIL="admin@ejemplo.com"

# ─── Groq API (Chat RAG + /asistente Telegram) ────────────────
GROQ_API_KEY=

# ─── Gemini API (Visión IA: análisis de piel + escáner ingredientes) ─
# Obtén tu key en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── PayPal (Pagos USD) ────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_API_URL=https://api-m.paypal.com

# ─── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth ──────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Precios ───────────────────────────────────────────────────
NEXT_PUBLIC_CUP_FALLBACK=500

# ─── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── WhatsApp ──────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Sentry (Monitoreo de errores — opcional, recomendado) ──────
# Sin Sentry: errores solo en logs. Con Sentry: reportes en dashboard.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── OpenWeatherMap (Clima real — opcional, recomendado) ─────────
# Sin API: clima tropical por defecto. Con API: rutina según clima real.
OPENWEATHER_API_KEY=

# ─── Google Analytics 4 (opcional) ──────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GA_STREAM_ID=

# ─── Microsoft Clarity (Analytics de comportamiento — opcional) ──
# ID del proyecto en Microsoft Clarity (https://clarity.microsoft.com)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ─── Telemetría ────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Seed ──────────────────────────────────────────────────────
SEED_ADMIN_PASSWORD=admin123

# ─── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_TOKEN=123456789:ABCdefGHIjklmNOPqrstUVwxyz
TELEGRAM_GROUP_ID=-123456789
TELEGRAM_ADMIN_TOKEN=admin_token_secreto_12345
TELEGRAM_VALIDATOR_TOKEN=validator_token_secreto_67890
TELEGRAM_WEBHOOK_SECRET=random-secret-for-webhook-verification

# ─── Umbrales del Bot ──────────────────────────────────────────
TRANSFER_PENDING_TIMEOUT_HOURS=2
TRANSFER_VALIDATED_TIMEOUT_MINUTES=30

# ─── Transfermóvil ─────────────────────────────────────────────
TRANSFER_ACCOUNT=9238000000000000
TRANSFER_HOLDER=Nombre del Titular

# ─── URLs del Sitio ────────────────────────────────────────────
SITE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ─── Cron Jobs ─────────────────────────────────────────────────
CRON_SECRET=generate-with-crypto-randombytes

# ─── Redis (Upstash — opcional, recomendado) ─────────────────────
# Sin Redis: caché en memoria (se pierde al reiniciar).
# Con Redis: caché persistente compartida entre instancias.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ─── Cloudinary (opcional, recomendado) ──────────────────────────
# Sin Cloudinary: logos se guardan como base64 en DB.
# Con Cloudinary: logos optimizados vía CDN.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Supabase Storage ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
