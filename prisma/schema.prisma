generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              String    @default("USER")
  plan              String    @default("FREE")
  qvapayId          String?
  stripeCustomerId  String?
  analysisLimit     Int       @default(1)
  analysisUsed      Int       @default(0)
  analysisResetAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  analyses      SkinAnalysis[]
  payments      Payment[]
  subscriptions Subscription[]
  purchasePacks PurchasePack[]
  usageRecords  UsageTracking[]
  clinic        Clinic?
  surveyFeedback SurveyFeedback[]
  communityPosts CommunityPost[]
  comments       Comment[]
  skinDiary      SkinDiary[]
  userChallenges UserChallenge[]
  productReviews ProductReview[]
  referralsOwned  Referral[]    @relation("ReferralOwner")
  referralsReferred Referral[]  @relation("ReferralReferred")
  groupsOwned    GroupAnalytics[]
  digitalPurchases DigitalProductPurchase[]

  @@index([plan])
  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SkinAnalysis {
  id              String   @id @default(cuid())
  userId          String?
  imageUrl        String?
  skinType        String?
  concerns        String?
  observations    String   @default("[]")
  recommendations String   @default("[]")
  routine         String?
  createdAt       DateTime @default(now())

  feedback        Feedback?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  image       String
  category    String
  tags        String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  readTime    Int?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([category])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  shortDesc   String?
  image       String
  category    String
  skinTypes   String   @default("all")
  price       Float    @default(0)
  ingredients String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews ProductReview[]

  @@index([isActive])
  @@index([category])
}

model Payment {
  id                String    @id @default(cuid())
  userId            String
  provider          String    @default("qvapay")
  qvapayId          String?   @unique
  stripePaymentId   String?   @unique
  plan              String
  amount            Float
  amountUsd         Float?
  amountCup         Float?
  currency          String    @default("USD")
  status            String    @default("pending")
  remoteId          String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  provider             String   @default("stripe")
  stripeSubscriptionId String?  @unique
  qvapayInvoiceId      String?  @unique
  plan                 String
  status               String   @default("active")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([currentPeriodEnd])
}

model PurchasePack {
  id        String   @id @default(cuid())
  userId    String
  packType  String
  provider  String   @default("stripe")
  amountUsd Float
  amountCup Float
  analyses  Int
  status    String   @default("completed")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
}

model UsageTracking {
  id        String   @id @default(cuid())
  userId    String
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Feedback {
  id              String   @id @default(cuid())
  analysisId      String   @unique
  rating          Int
  comment         String?
  wouldRecommend  Boolean
  createdAt       DateTime @default(now())

  analysis SkinAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([createdAt])
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  address   String?
  phone     String?
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model AffiliateClick {
  id          String   @id @default(cuid())
  productName String
  query       String?
  provider    String   @default("amazon")
  url         String
  refParam    String?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([productName])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model Cache {
  key       String   @id
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventType   String
  payload     String
  processedAt DateTime?
  attempts    Int       @default(0)
  lastAttempt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([processedAt])
  @@index([attempts])
  @@index([provider])
  @@index([provider, eventType])
}

model UserEvolution {
  id           String   @id @default(cuid())
  userId       String   @unique
  data         String
  lastAnalysis DateTime
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([resetAt])
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SurveyFeedback {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model CommunityPost {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String
  category    String   @default("general")
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model SkinDiary {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  feeling   Int
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String
  points      Int      @default(10)
  frequency   String   @default("weekly")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  userChallenges UserChallenge[]

  @@index([active])
  @@index([createdAt])
}

model UserChallenge {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
}

model ProductReview {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model EmailLog {
  id        String   @id @default(cuid())
  subject   String
  body      String
  recipient String
  segment   String
  status    String   @default("sent")
  batchId   String?
  sentAt    DateTime @default(now())

  @@index([sentAt])
  @@index([recipient])
}

model Unsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([email])
}

model GroupAnalytics {
  id             String   @id @default(cuid())
  groupId        String   @unique
  referrerId     String
  invitedCount   Int      @default(0)
  completedCount Int      @default(0)
  totalRevenue   Float    @default(0)
  status         String   @default("pending")
  notifiedAdmin  Boolean  @default(false)
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  expiresAt      DateTime
  metadata       Json?

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([status])
  @@index([groupId])
}

model Referral {
  id           String    @id @default(cuid())
  referrerId   String
  referredId   String?
  code         String    @unique
  groupId      String?
  status       String    @default("pending")
  discountPrice Float?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  referrer User     @relation("ReferralOwner", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User?    @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([code])
  @@index([groupId])
  @@index([status])
}

model DigitalProduct {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  shortDesc   String?
  image       String
  category    String
  price       Float
  fileUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases DigitalProductPurchase[]

  @@index([isActive])
  @@index([category])
}

model DigitalProductPurchase {
  id              String   @id @default(cuid())
  userId          String
  digitalProductId String
  amount          Float
  currency        String   @default("USD")
  provider        String   @default("qvapay")
  qvapayId        String?  @unique
  status          String   @default("completed")
  downloadUrl     String?
  createdAt       DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  digitalProduct DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([digitalProductId])
  @@index([status])
}
