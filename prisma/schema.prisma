generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  username          String?   @unique
  role              String    @default("USER")
  plan              String    @default("FREE")
  qvapayId          String?
  analysisLimit     Int       @default(1)
  analysisUsed      Int       @default(0)
  analysisResetAt   DateTime?
  telegramId        String?
  telegramTrialStartedAt DateTime?
  isTelegramPremiumActive Boolean @default(false)
  latitude          Float?
  longitude         Float?
  currentStreak     Int       @default(0)
  maxStreak         Int       @default(0)
  lastCheckInDate   DateTime?
  trialEndsAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  analyses      SkinAnalysis[]
  analysisJobs  AnalysisJob[]
  payments      Payment[]
  subscriptions Subscription[]
  purchasePacks PurchasePack[]
  usageRecords  UsageTracking[]
  clinic        Clinic?  @relation("UserClinic")
  clients       Client[]
  surveyFeedback SurveyFeedback[]
  communityPosts CommunityPost[]
  comments       Comment[]
  skinDiary      SkinDiary[]
  userChallenges UserChallenge[]
  productReviews ProductReview[]
  referralsOwned  Referral[]    @relation("ReferralOwner")
  referralsReferred Referral[]  @relation("ReferralReferred")
  groupsOwned    GroupAnalytics[]
  digitalPurchases DigitalProductPurchase[]
  affiliateClicks   AffiliateClick[]
  evolution         UserEvolution?
  checkIns          DailyCheckIn[]
  transferPayments  TransferPayment[]
  validatedTransfers TransferPayment[] @relation("TransferValidator")
  activatedTransfers TransferPayment[] @relation("TransferActivator")
  auditLogs         AuditLog[]
  notifications     Notification[]
  supportTickets    SupportTicket[]
  ticketResponses   SupportTicketResponse[]
  chatMessages      ChatMessage[]
  contactMessages   ContactMessage[]
  communityGroups    CommunityGroup[]   @relation("GroupCreator")
  communityMemberships CommunityMember[]
  postReactions      PostReaction[]
  giftPacksBought    GiftPack[]       @relation("GiftBuyer")
  giftPacksRedeemed  GiftPack[]       @relation("GiftRedeemer")
  reminders              UserReminder[]
  referredByEstheticianId String?
  referredBy             Clinic?     @relation("UserReferredBy", fields: [referredByEstheticianId], references: [id], onDelete: SetNull)

  @@index([plan])
  @@index([role])
  @@index([createdAt])
  @@index([trialEndsAt])
  @@index([telegramId])
}

model AnalysisJob {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("PENDING")
  priority  Int      @default(0)
  attempts  Int      @default(0)
  photos    String   @default("[]") // JSON array of base64
  body      String?  // JSON with concerns, age, gender, etc
  result    String?  // JSON result from Groq
  error     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SkinAnalysis {
  id              String   @id @default(cuid())
  userId          String?
  clientId        String?
  imageUrl        String?
  skinType        String?
  concerns        String?
  observations    String   @default("[]")
  recommendations String   @default("[]")
  routine         String?
  createdAt       DateTime @default(now())

  feedback        Feedback?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([skinType])
  @@index([userId, skinType])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  image       String
  category    String
  tags        String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  readTime    Int?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([category])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  shortDesc   String?
  image       String
  category    String
  skinTypes   String   @default("all")
  price       Float    @default(0)
  ingredients String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews ProductReview[]

  @@index([isActive])
  @@index([category])
  @@index([isActive, category])
}

model Payment {
  id                String    @id @default(cuid())
  userId            String
  provider          String    @default("qvapay")
  qvapayId          String?   @unique
  plan              String
  amount            Float
  amountUsd         Float?
  amountCup         Float?
  currency          String    @default("USD")
  status            String    @default("pending")
  remoteId          String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@index([provider, status])
}

model TransferPayment {
  id              String    @id @default(cuid())
  userId          String
  plan            String
  amount          Float
  referenceCode   String    @unique
  status          String    @default("pending") // pending, validated, activated, cancelled
  transferAccount String?
  transferHolder  String?
  validatedById   String?
  activatedById   String?
  validatedAt     DateTime?
  activatedAt     DateTime?
  createdAt       DateTime  @default(now())

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  validator     User? @relation("TransferValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  activator     User? @relation("TransferActivator", fields: [activatedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([referenceCode])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // validate_transfer, activate_transfer, cancel_transfer, admin_login, user_impersonate
  targetId  String?  // ID of the affected payment/transfer/user
  targetType String? // "transfer", "payment", "user"
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  provider             String   @default("qvapay")
  qvapayInvoiceId      String?  @unique
  plan                 String
  status               String   @default("active")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([currentPeriodEnd])
}

model PurchasePack {
  id        String   @id @default(cuid())
  userId    String
  packType  String
  provider  String   @default("qvapay")
  amountUsd Float
  amountCup Float
  analyses  Int
  status    String   @default("completed")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
}

model UsageTracking {
  id        String   @id @default(cuid())
  userId    String
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Feedback {
  id              String   @id @default(cuid())
  analysisId      String   @unique
  rating          Int
  comment         String?
  wouldRecommend  Boolean
  createdAt       DateTime @default(now())

  analysis SkinAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([createdAt])
}

model Clinic {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  referralCode  String   @unique
  logo          String?
  address       String?
  phone         String?
  licenseNumber String?
  ownerId       String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User     @relation("UserClinic", fields: [ownerId], references: [id], onDelete: Cascade)
  clients       Client[]
  referredUsers User[]  @relation("UserReferredBy")

  @@index([referralCode])
}

model AffiliateClick {
  id          String   @id @default(cuid())
  productName String
  query       String?
  provider    String   @default("amazon")
  url         String
  refParam    String?
  userId      String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([productName])
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("pending")
  read      Boolean  @default(false)
  reply     String?
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model BotLog {
  id        String   @id @default(cuid())
  chatId    String
  userId    String?
  command   String
  message   String?
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([userId])
  @@index([createdAt])
}

model BotKnowledge {
  id             String    @id @default(cuid())
  title          String
  content        String
  category       String    // "general", "pricing", "analysis", "blog", "product", "support"
  subcategory    String?   // "faq", "tutorial", "review", "guide"
  source         String    @default("web")   // "web", "blog", "admin", "manual"
  sourceUrl      String?   // URL original de la página
  priority       Int       @default(0)       // 0-10 (más alto = más importante)
  keywords       String[]
  synonyms       String[]  @default([])      // formas alternativas de preguntar
  validFrom      DateTime  @default(now())
  validUntil     DateTime? // NULL = indefinido
  version        Int       @default(1)
  updatedBy      String?   // ID del admin
  helpfulCount   Int       @default(0)
  unhelpfulCount Int       @default(0)
  lastUsedAt     DateTime?
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  feedback BotFeedback[]

  @@index([category])
  @@index([enabled])
  @@index([priority])
  @@index([source])
}

model BotFeedback {
  id          String       @id @default(cuid())
  knowledgeId String?
  knowledge   BotKnowledge? @relation(fields: [knowledgeId], references: [id], onDelete: SetNull)
  userId      String?
  chatId      String
  rating      Int          @default(0)
  helpful     Boolean?
  comment     String?
  createdAt   DateTime     @default(now())

  @@index([knowledgeId])
  @@index([helpful])
}

model Cache {
  key       String   @id
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventType   String
  payload     String
  processedAt DateTime?
  attempts    Int       @default(0)
  lastAttempt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([processedAt])
  @@index([attempts])
  @@index([provider])
  @@index([provider, eventType])
}

model UserEvolution {
  id           String   @id @default(cuid())
  userId       String   @unique
  data         String
  lastAnalysis DateTime
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([resetAt])
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SurveyFeedback {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model CommunityPost {
  id          String   @id @default(cuid())
  userId      String
  groupId     String?
  title       String
  content     String
  category    String   @default("general")
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    CommunityGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  comments Comment[]
  reactions PostReaction[]

  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@index([groupId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model CommunityGroup {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  image       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User             @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members  CommunityMember[]
  posts    CommunityPost[]

  @@index([createdById])
  @@index([slug])
}

model CommunityMember {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())

  group   CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      String   @default("LIKE")
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model ConversationState {
  chatId    String   @id
  step      String
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
}

model SkinDiary {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  feeling   Int
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String
  points      Int      @default(10)
  frequency   String   @default("weekly")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  userChallenges UserChallenge[]

  @@index([active])
  @@index([createdAt])
}

model UserChallenge {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
}

model ProductReview {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model GroupAnalytics {
  id             String   @id @default(cuid())
  groupId        String   @unique
  referrerId     String
  invitedCount   Int      @default(0)
  completedCount Int      @default(0)
  totalRevenue   Float    @default(0)
  status         String   @default("pending")
  notifiedAdmin  Boolean  @default(false)
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  expiresAt      DateTime
  metadata       Json?

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([status])
  @@index([groupId])
}

model Referral {
  id              String    @id @default(cuid())
  referrerId      String
  referredId      String?
  code            String    @unique
  groupId         String?
  status          String    @default("pending")
  discountPrice   Float?
  firstAnalysisAt DateTime?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  referrer User     @relation("ReferralOwner", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User?    @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([code])
  @@index([groupId])
  @@index([status])
}

model DigitalProduct {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  shortDesc   String?
  image       String
  category    String
  level       String   @default("principiante")
  price       Float
  fileUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases DigitalProductPurchase[]

  @@index([isActive])
  @@index([category])
  @@index([level])
}

model DigitalProductPurchase {
  id              String   @id @default(cuid())
  userId          String
  digitalProductId String
  amount          Float
  currency        String   @default("USD")
  provider        String   @default("qvapay")
  qvapayId        String?  @unique
  status          String   @default("completed")
  downloadUrl     String?
  createdAt       DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  digitalProduct DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([digitalProductId])
  @@index([status])
}

model DailyCheckIn {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  routine   String   @default("morning") // morning, evening
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, routine])
  @@index([userId])
  @@index([date])
}

model IngredientKB {
  id            String   @id @default(cuid())
  name          String   @unique
  category      String   // manchas, arrugas, poros, sensibilidad, hidratacion, acne
  mechanism     String
  concentration String
  evidence      String
  pairsWith     String   @default("")
  caution       String?
  createdAt     DateTime @default(now())

  @@index([category])
}

model Client {
  id            String   @id @default(cuid())
  estheticianId String
  clinicId      String
  name          String
  email         String?
  phone         String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  esthetician User   @relation(fields: [estheticianId], references: [id], onDelete: Cascade)
  clinic      Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  analyses    SkinAnalysis[]

  @@index([estheticianId])
  @@index([clinicId])
}

model TelegramAuth {
  id        String   @id @default(cuid())
  chatId    String   @unique
  role      String   // "ADMIN" | "VALIDATOR"
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([role])
}

model TelegramLog {
  id        String   @id @default(cuid())
  chatId    String
  username  String?
  command   String
  args      String?
  role      String?
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  title      String
  message    String
  link       String?
  read       Boolean   @default(false)
  emailSent  Boolean   @default(false)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([emailSent])
  @@index([sentAt])
  @@index([createdAt])
}

model TelegramAlert {
  id        String   @id @default(cuid())
  chatId    String   @unique
  events    String   @default("[]") // JSON array: ["new_user","new_analysis","pending_24h","critical_error"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId])
}

model DiscountCode {
  id        String    @id @default(cuid())
  code      String    @unique
  discount  Int       // percentage 0-100
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  createdBy String    // telegram chatId
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([code])
  @@index([active])
}

model TelegramReminder {
  id        String   @id @default(cuid())
  chatId    String   @unique
  userId    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId])
  @@index([active])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String   @default("open") // open, in_progress, resolved, closed
  priority  String   @default("normal") // low, normal, high, urgent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses SupportTicketResponse[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SupportTicketResponse {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  message   String
  isAdmin   Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([createdAt])
  @@index([read])
}

model LeadMagnet {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model GiftPack {
  id            String   @id @default(cuid())
  buyerId       String
  recipientEmail String
  packType      String
  analyses      Int
  giftCode      String   @unique
  status        String   @default("pending")
  redeemedById  String?
  redeemedAt    DateTime?
  createdAt     DateTime @default(now())

  buyer       User  @relation("GiftBuyer", fields: [buyerId], references: [id])
  redeemedBy  User? @relation("GiftRedeemer", fields: [redeemedById], references: [id])

  @@index([giftCode])
  @@index([buyerId])
  @@index([status])
}

model UserReminder {
  id        String   @id @default(cuid())
  userId    String
  frequency String   @default("weekly")
  enabled   Boolean  @default(true)
  lastSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([enabled])
}
